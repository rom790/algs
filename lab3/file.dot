digraph Bohr {
    node [shape=circle];
    0 [label="0"];
    0 -> 1 [label="d"];
    1 [label="1 (2)", style=filled, color=lightblue];
    1 -> 2 [label="a"];
    1 -> 0 [style=dotted, color=red];
    1 -> 0 [style=dashed, color=green];
    2 [label="2"];
    2 -> 3 [label="c"];
    2 -> 0 [style=dotted, color=red];
    2 -> 0 [style=dashed, color=green];
    3 [label="3 (1)", style=filled, color=lightblue];
    3 -> 4 [label="d"];
    3 -> 0 [style=dotted, color=red];
    3 -> 0 [style=dashed, color=green];
    4 [label="4 (0)", style=filled, color=lightblue];
}
